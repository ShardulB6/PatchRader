# The sslip.io name maps to the server's IP. It stays so that links shared
# before the project had its own domain keep working.
patchrader.health, 155-138-145-151.sslip.io {
	encode zstd gzip
	# The AI analyst API. Only /api/* is exposed; FastAPI's docs pages are not.
	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

www.patchrader.health {
	redir https://patchrader.health{uri}
}

http://155.138.145.151 {
	redir https://patchrader.health{uri}
}
