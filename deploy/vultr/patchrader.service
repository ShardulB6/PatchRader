[Unit]
Description=PatchRader dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=patchrader
Group=patchrader
WorkingDirectory=/srv/patchrader/app/apps/web
Environment=NODE_ENV=production
# --static is resolved relative to the entry file, so ../client means dist/client.
ExecStart=/usr/local/bin/srvx serve --prod --entry dist/server/server.js --static ../client --host 127.0.0.1 --port 3000
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
