# Copy to backend/.env; never commit the real .env file.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# Toronto does not offer Granite chat models, so chat uses Llama on watsonx.ai.
# For Granite chat, use a us-south project with WATSONX_MODEL_ID=ibm/granite-4-h-small.
WATSONX_URL=https://ca-tor.ml.cloud.ibm.com
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct
# Relative to backend/. scripts/fetch_data.py downloads the dataset to the repo-root data/.
PATCHRADAR_DATA_DIR=../data
# Questions per visitor per minute, and watsonx.ai-backed answers per UTC day.
CHAT_PER_MINUTE=6
WATSONX_DAILY_LIMIT=100
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
